{
  "name": "sths-flask-pwa",
  "version": "1.0.0",
  "description": "Sydney Technical High School – High‑Security Flask PWA Template",
  "private": true,
  "scripts": {
    "dev": "tailwindcss -i src/app/static/src/input.css -o src/app/static/css/tailwind.css --watch",
    "build": "tailwindcss -i src/app/static/src/input.css -o src/app/static/css/tailwind.css",
    "build:prod": "tailwindcss -i src/app/static/src/input.css -o src/app/static/css/tailwind.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  }
}
