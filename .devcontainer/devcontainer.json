{
  "name": "High Security Flask PWA Development Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bullseye",

  "features": {},

  "containerEnv": {
    "PATH": "/home/vscode/.local/bin:${PATH}"
  },

  "postCreateCommand": "UV_VERSION=0.9.26 curl -LsSf https://astral.sh/uv/install.sh | sh",

  "portsAttributes": {
    "5000": {
      "label": "Flask Application",
      "onAutoForward": "openPreview",
      "protocol": "http",
      "visibility": "public",
      "requireLocalPort": false,
      "elevateIfNeeded": true
    }
  },

  "forwardPorts": [5000],

  "customizations": {
    "vscode": {
      "settings": {
        "files.autoSave": "onFocusChange",
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "editor.fontSize": 18,
        "extensions.ignoreRecommendations": true,
        "unwantedRecommendations": ["ms-python.vscode-python-envs"],
        "terminal.integrated.defaultProfile.windows": "Git Bash",
        "window.restoreWindows": "preserve",
        "workbench.editorAssociations": {
          "*.md": "vscode.markdown.preview.editor"
        },
        "workbench.colorTheme": "Default Dark+",
        "workbench.iconTheme": "vscode-icons",
        "github.copilot.enable": {
          "python": false,
          "html": false,
          "css": false,
          "SQL": false
        },
        "chat.agent.enabled": false,
        "github.copilot.chat.participant.alwaysInclude": [
          "copilot-instructions.md"
        ],
        "workbench.editor.enablePreview": true,
        "workbench.editor.enablePreviewFromQuickOpen": true,
        "liveServer.settings.root": ".student_resources"
      },
      "extensions": [
        "bierner.markdown-mermaid",
        "bierner.markdown-preview-github-styles",
        "ecmel.vscode-html-css",
        "esbenp.prettier-vscode",
        "GitHub.codespaces",
        "mathematic.vscode-pdf",
        "McCarter.start-git-bash",
        "mechatroner.rainbow-csv",
        "ms-python.black-formatter",
        "ms-python.debugpy",
        "ms-python.pylint",
        "ms-python.python",
        "oderwat.indent-rainbow",
        "streetsidesoftware.code-spell-checker",
        "tal7aouy.icons",
        "saeris.markdown-github-alerts",
        "yy0931.vscode-sqlite3-editor",
        "github.copilot",
        "ritwickdey.liveserver"
      ]
    }
  }
}
