{
  "name": "High Security Flask PWA",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",

  // ------------------------------------------------------------
  // Automatically forward Flask's port
  // ------------------------------------------------------------
  "forwardPorts": [5000],

  // ------------------------------------------------------------
  // Environment variables available to the container
  // ------------------------------------------------------------
  "remoteEnv": {
    "FLASK_APP": "src.app:create_app",
    "FLASK_ENV": "development"
  },

  // ------------------------------------------------------------
  // Commands that run AFTER the container is created
  // ------------------------------------------------------------
  "postCreateCommand": "
    curl -LsSf https://astral.sh/uv/install.sh | sh &&
    source ~/.profile &&
    uv venv .venv &&
    source .venv/bin/activate &&
    uv sync
  ",

  // ------------------------------------------------------------
  // Commands that run EVERY TIME the Codespace starts
  // ------------------------------------------------------------
  "postStartCommand": "
    echo 'source /workspaces/High-Security-Flask-PWA-Repo-Template/.venv/bin/activate' >> ~/.bashrc &&
    source ~/.bashrc &&
    flask run --host 0.0.0.0 --port 5000
  ",

  // ------------------------------------------------------------
  // VS Code extensions (optional but helpful)
  // ------------------------------------------------------------
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
