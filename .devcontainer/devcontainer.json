{
  "name": "High Security Flask PWA Devcontainer",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/high-security-flask-pwa-template/.venv/bin/python",
        "python.analysis.typeCheckingMode": "strict",
        "markdown.preview.openMarkdownFiles": "inPreview",
        "markdown.preview.openMarkdownLinks": "inPreview",
        "workbench.startupEditor": "readme"
      }
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },

  "forwardPorts": [5000],

  "portsAttributes": {
    "5000": {
      "label": "Flask Application",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "bash .devcontainer/scripts/install-uv.sh && UV_NO_DEV=1 uv sync && bash .devcontainer/preflight.sh",

  "postAttachCommand": "sleep 5 && uv run flask --debug run --host 0.0.0.0 --port 5000",

  "postStartCommand": "bash .devcontainer/scripts/health-check.sh || true",

  "postStartCommandDenylist": [],

  "features": {}
}
