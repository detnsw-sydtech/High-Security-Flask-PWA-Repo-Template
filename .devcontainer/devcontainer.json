{
  "name": "High Security Flask PWA Devcontainer",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {}
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  },

  "forwardPorts": [5000],

  "portsAttributes": {
    "5000": {
      "label": "Flask Application",
      "onAutoForward": "openPreview"
    }
  },

  "postCreateCommand": "bash .devcontainer/scripts/install-uv.sh && bash .devcontainer/preflight.sh && bash .devcontainer/scripts/rebuild-venv.sh",

  "postAttachCommand": "sleep 5 && uv run flask --debug run",

  "postStartCommand": "bash .devcontainer/scripts/purge-vm.sh && bash .devcontainer/scripts/diagnostics.sh && bash .devcontainer/startup.sh",

  "features": {}
}
