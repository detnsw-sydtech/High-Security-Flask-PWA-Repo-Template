{
  "name": "High Security Flask PWA",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",

  "forwardPorts": [5000],

  "remoteEnv": {
    "FLASK_APP": "src.app:create_app",
    "FLASK_ENV": "development"
  },

  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && source ~/.profile && uv venv .venv && uv sync",

  "postStartCommand": "echo 'source $(pwd)/.venv/bin/activate' >> ~/.bashrc && source ~/.bashrc && flask run --host 0.0.0.0 --port 5000",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
