{
  "name": "Flask Auto Launch",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bullseye",

  "forwardPorts": [5000],

  "remoteEnv": {
    "FLASK_APP": "src.app:create_app",
    "FLASK_ENV": "development"
  },

  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && uv venv .venv && uv sync",

  "postStartCommand": "echo 'source $(pwd)/.venv/bin/activate' >> ~/.bashrc && source ~/.bashrc && sleep 2 && flask run --host 0.0.0.0 --port 5000"
}
